  "components": {
    "schemas": {
      "ArticleInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 2,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 10,
            "title": "Body"
          },
          "category": {
            "type": "string",
            "enum": [
              "配送",
              "請求",
              "アカウント",
              "その他"
            ],
            "title": "Category",
            "default": "その他"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "ArticleInput"
      },
      "Generate": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "request_key": {
            "type": "string",
            "format": "uuid",
            "title": "Request Key"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          },
          "source_digest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Source Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "request_key",
          "source_digest"
        ],
        "title": "Generate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "NoteInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 2,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "NoteInput"
      },
      "Review": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Action"
          },
          "text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Text"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 2,
            "title": "Note"
          },
          "checked": {
            "type": "boolean",
            "title": "Checked"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "text",
          "note",
          "checked"
        ],
        "title": "Review"
      },
      "TicketCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 2,
            "title": "Title"
          },
          "customer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer"
          },
          "body": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 5,
            "title": "Body"
          },
          "category": {
            "type": "string",
            "enum": [
              "配送",
              "請求",
              "アカウント",
              "その他"
            ],
            "title": "Category",
            "default": "その他"
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "high"
            ],
            "title": "Priority",
            "default": "normal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "customer",
          "body"
        ],
        "title": "TicketCreate"
      },
      "TicketUpdate": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "resolved"
            ],
            "title": "Status"
          },
          "assignee_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "status"
        ],
        "title": "TicketUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
